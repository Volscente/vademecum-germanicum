# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
POSTGRES_HOST_DOCKER=db
POSTGRES_HOST_LOCAL=localhost

# Assemble the URL for local debugging (VS Code / Pytest)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST_LOCAL}:${POSTGRES_PORT}/${POSTGRES_DB}

# LLM (enrichment feature)
GEMINI_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Auth — JWT_SECRET: any long random string (e.g. `openssl rand -hex 32`).
# ALLOWED_USERNAMES: comma-separated list of usernames permitted to register.
JWT_SECRET=
ALLOWED_USERNAMES=

# CORS — comma-separated list of frontend origins allowed to call the API.
# Add the deployed Vercel URL alongside localhost when running in the cloud.
CORS_ALLOWED_ORIGINS=http://localhost:3000
